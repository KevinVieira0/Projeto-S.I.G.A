
# Preencha localmente; não versione seu .env.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/siga"
DIRECT_URL="postgresql://USUARIO:SENHA@localhost:5432/siga"
NEXT_PUBLIC_API_URL="/api"

# Recursos locais de teste: só têm efeito com npm run dev (NODE_ENV=development).
# true mostra o botão "Preencher dados de teste" em Alunos > Novo aluno.
NEXT_PUBLIC_MODO_TESTE="true"
# false aceita CPF com 11 dígitos sem conferir os verificadores no cadastro interno.
# true (ou variável ausente) mantém a validação. Em produção ela é sempre obrigatória.
VALIDAR_CPF="false"

# Obrigatória para os dois logins. Gere com:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
# Opcional: origem pública exata quando houver proxy reverso.
# APP_ORIGIN="https://seu-dominio"

ADMIN_INITIAL_NAME=""
ADMIN_INITIAL_EMAIL=""
ADMIN_INITIAL_PASSWORD=""
EMPRESA_TEST_PASSWORD=""

GOOGLE_APPLICATION_CREDENTIALS=""

# Nova planilha de formulários, catálogo e espelho do banco oficial.
# Abas Cursos, Turmas, Alunos, Empresas e Matriculas; cabeçalhos na linha 4.
GOOGLE_SHEETS_ACADEMICO_ID=""

# Processar alunos por CPF e empresas por CNPJ a cada cinco minutos com o portal aberto.
GOOGLE_SHEETS_RECEBIMENTOS_AUTO="false"

# Espelhar cadastros, matrículas e histórico. A conta de serviço precisa ser Editora.
GOOGLE_SHEETS_ESPELHO_AUTO="false"
