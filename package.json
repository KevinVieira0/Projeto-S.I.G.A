{
  "name": "projeto-login",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"scripts/**/*.js\" \"tests/**/*.js\" && prettier --parser babel --write \"scripts/**/*.gs\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"scripts/**/*.js\" \"tests/**/*.js\" && prettier --parser babel --check \"scripts/**/*.gs\"",
    "test": "npm run test:cadastros",
    "test:cadastros": "tsx --tsconfig jsconfig.json --test tests/formulariosAutomaticos.test.js tests/cadastrosAutomaticos.integration.test.js",
    "db:recebimentos": "tsx --tsconfig jsconfig.json scripts/buscar-recebimentos.js",
    "db:demonstracao:previa": "tsx --tsconfig jsconfig.json scripts/preparar-demonstracao.js",
    "db:previa-academica": "tsx --tsconfig jsconfig.json scripts/previa-base-academica.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "googleapis": "^176.0.0",
    "lucide-react": "^0.446.0",
    "next": "^14.2.0",
    "pg": "^8.22.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.53.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.47",
    "prettier": "3.6.2",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.9"
  }
}
