generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Administrador {
  id           String   @id @default(uuid())
  nome         String   @db.VarChar(150)
  email        String   @unique @db.VarChar(255)
  senhaHash    String   @map("senha_hash") @db.VarChar(255)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("administradores")
}

model Empresa {
  id               String   @id @default(uuid())
  cnpj             String   @unique @db.Char(14)
  razaoSocial      String   @map("razao_social") @db.VarChar(255)
  nomeFantasia     String?  @map("nome_fantasia") @db.VarChar(255)
  email            String?  @db.VarChar(255)
  telefone         String?  @db.VarChar(20)
  senhaHash String? @map("senha_hash") @db.VarChar(255)
  autorizada       Boolean  @default(false)
  ativa            Boolean  @default(true)
  solicitacoes     Solicitacao[] 
  criadoEm         DateTime @default(now()) @map("criado_em")
  atualizadoEm     DateTime @updatedAt @map("atualizado_em")

  alunos Aluno[]

  @@index([autorizada, ativa])
  @@map("empresas")
}

model Aluno {
  id                String   @id @default(uuid())
  nome              String   @db.VarChar(150)
  cpf               String   @unique @db.Char(11)
  celular           String?  @db.VarChar(20)
  email             String?  @db.VarChar(255)
  genero            String?  @db.VarChar(30)
  idade             Int
  modalidade        String   @db.VarChar(50)
  curso             String   @db.VarChar(150)
  turma             String   @db.VarChar(50)
  periodo           String   @db.VarChar(20)
  termo             Int
  empregado         Boolean  @default(false)
  empresaId         String?  @map("empresa_id")
  statusIndicacao   String   @default("Não indicado") @map("status_indicacao") @db.VarChar(30)
  dataCadastro      DateTime @default(now()) @map("data_cadastro")
  ultimaAtualizacao DateTime @updatedAt @map("ultima_atualizacao")

  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([empresaId])
  @@index([curso, turma])
  @@index([statusIndicacao])
  @@map("alunos")
}

model Solicitacao {
  id               String   @id @default(uuid())
  idEmpresa        String
  idadeMinima      Int
  idadeMaxima      Int
  sexo             String
  pratica          String // descrição da prática exigida
  cursos           String // lista de cursos (armazenado como text[] no Postgres)
  inicio           DateTime
  fim              DateTime
  quantidadeAlunos Int
  observacoes      String?  @db.Text
  ativa            Boolean  @default(true)
  criadoEm         DateTime @default(now())
  
  empresa          Empresa  @relation(fields: [idEmpresa], references: [id])
  @@map("Solicitacoes")
}